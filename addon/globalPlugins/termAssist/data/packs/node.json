   "th": "แอปใน PM2",
   "en": "PM2 app",
   "default": "",
   "source": "pm2 jlist 2>/dev/null | grep -o '\"name\":\"[^\"]*\"' | cut -d'\"' -f4 | sort -u"
  },
  "script": {
   "th": "ชื่อสคริปต์ใน package.json",
   "en": "package.json script",
   "default": "",
   "source": "node -e \"console.log(Object.keys(require('./package.json').scripts||{}).join('\\n'))\""
  }
 },
